      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;_USRDLL;BLACKJACKCHEAT_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <FloatingPointModel>Fast</FloatingPointModel>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <AdditionalIncludeDirectories>external\spdlog\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Localization.cpp embeds non-ASCII (Cyrillic/CJK) string
           literals directly, saved as UTF-8. Without this flag, MSVC
           reinterprets them against the current ANSI code page instead
           and mangles every non-Latin translation. Same fix PokerCheat's
           own vcxproj already carries, there for a different reason
           (spdlog's bundled fmt static_asserting on the code page);
           this project uses SPDLOG_USE_STD_FORMAT instead (see Log.h),
           so it never needed the flag until now. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
