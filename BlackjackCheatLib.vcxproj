  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- Outputs stay inside this repo (bin/ and tmp/ are gitignored), also
         when a parent project builds it through a ProjectReference. -->
